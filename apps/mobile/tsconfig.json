{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": [
      "react-native"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "expo-sqlite": [
        "./node_modules/expo-sqlite"
      ],
      "@/*": [
        "./src/*"
      ],
      "@drmoo/engine": [
        "../../packages/engine/src/index.ts"
      ],
      "@drmoo/knowledge": [
        "../../packages/knowledge/src/index.ts"
      ],
      "@drmoo/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@drmoo/db": [
        "../../packages/db/src/index.ts"
      ],
      "@drmoo/planilha": [
        "../../packages/planilha/src/index.ts"
      ],
      "@drmoo/relatorio": [
        "../../packages/relatorio/src/index.ts"
      ],
      "@drmoo/sync": [
        "../../packages/sync/src/index.ts"
      ],
      "@drmoo/ui": [
        "../../packages/ui/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js"
  ]
}
